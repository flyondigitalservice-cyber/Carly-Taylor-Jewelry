<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'en' }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="{{ settings.color_background }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

  {%- render 'head-seo' -%}

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
  {%- else -%}
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
  {%- endif -%}

  {%- render 'theme-styles' -%}
  {{ 'base.css' | asset_url | stylesheet_tag }}

  <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  <script src="{{ 'cart.js' | asset_url }}" defer></script>
  <script src="{{ 'product.js' | asset_url }}" defer></script>
  {%- if template.name == 'collection' or template.name == 'search' -%}
    <script src="{{ 'collection.js' | asset_url }}" defer></script>
  {%- endif -%}
  <script src="{{ 'search.js' | asset_url }}" defer></script>

  {{ content_for_header }}
</head>

<body class="template-{{ template.name | handleize }}{% if template.suffix %} template-suffix-{{ template.suffix | handleize }}{% endif %}">
  <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

  {%- render 'icon-set' -%}

  {% sections 'header-group' %}

  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {%- render 'cart-drawer' -%}
  {%- if settings.wishlist_enable -%}{%- render 'wishlist-drawer' -%}{%- endif -%}
  {%- render 'quick-add-modal' -%}
  {%- if settings.enable_size_guide -%}{%- render 'size-guide-modal' -%}{%- endif -%}
  {%- render 'zoom-lightbox' -%}
  {%- render 'whatsapp-float' -%}
  <div id="ToastHost" class="toast-host" aria-live="polite" aria-atomic="true"></div>

  <script type="application/json" id="ShopRoutes">
    {{ routes | json }}
  </script>
  {%- liquid
    assign gw_product = settings.gift_wrap_product
    assign en_product = settings.engraving_product
  -%}
  <script type="application/json" id="ShopSettings">
    {
      "money_format": {{ shop.money_format | json }},
      "currency": {{ cart.currency.iso_code | json }},
      "indian_format": {{ settings.money_indian_format | json }},
      "hide_paise": {{ settings.money_hide_paise | json }},
      "cart_drawer": {{ settings.cart_drawer_enable | json }},
      "free_ship": {{ settings.free_shipping_threshold | json }},
      "free_ship_on": {{ settings.cart_free_shipping | json }},
      "wishlist": {{ settings.wishlist_enable | json }},
      "swatch_names": {{ settings.swatch_option_names | json }},
      "size_names": {{ settings.size_option_names | json }},
      "swatch_map": {{ settings.swatch_map | json }},
      "coating_tint": {{ settings.enable_coating_tint | json }},
      "gift_wrap_variant": {% if gw_product != blank and gw_product.available %}{{ gw_product.selected_or_first_available_variant.id | json }}{% else %}null{% endif %},
      "engraving_variant": {% if en_product != blank and en_product.available %}{{ en_product.selected_or_first_available_variant.id | json }}{% else %}null{% endif %},
      "engraving_max": {{ settings.engraving_max_chars | json }},
      "lowstock": {{ settings.lowstock_threshold | json }},
      "delivery_min": {{ settings.delivery_days_min | json }},
      "delivery_max": {{ settings.delivery_days_max | json }},
      "pincode_blocked": {{ settings.pincode_blocked | json }},
      "pincode_no_cod": {{ settings.pincode_no_cod | json }},
      "cod": {{ settings.enable_cod | json }},
      "show_mrp": {{ settings.show_mrp_label | json }},
      "strings": {
        "added": {{ 'products.added' | t | json }},
        "add_to_cart": {{ 'products.add_to_cart' | t | json }},
        "sold_out": {{ 'products.sold_out' | t | json }},
        "mrp": {{ 'products.mrp' | t | json }},
        "percent_off": {{ 'products.percent_off' | t | json }},
        "unavailable": {{ 'products.unavailable' | t | json }},
        "in_stock": {{ 'products.in_stock' | t | json }},
        "only_left": {{ 'products.only_left' | t | json }},
        "select_size": {{ 'products.select_size' | t | json }},
        "select_coating": {{ 'products.select_coating' | t | json }},
        "pincode_invalid": {{ 'products.pincode_invalid' | t | json }},
        "pincode_ok": {{ 'products.pincode_ok' | t | json }},
        "pincode_bad": {{ 'products.pincode_bad' | t | json }},
        "pincode_cod_yes": {{ 'products.pincode_cod_yes' | t | json }},
        "pincode_cod_no": {{ 'products.pincode_cod_no' | t | json }},
        "free_ship_done": {{ 'cart.free_shipping_done' | t | json }},
        "free_ship_progress": {{ 'cart.free_shipping_progress' | t | json }},
        "cart_empty": {{ 'cart.empty' | t | json }},
        "cart_empty_cta": {{ 'cart.empty_cta' | t | json }},
        "cart_error": {{ 'cart.error' | t | json }},
        "remove": {{ 'general.remove' | t | json }},
        "quantity": {{ 'general.quantity' | t | json }},
        "wl_added": {{ 'wishlist.added' | t | json }},
        "wl_removed": {{ 'wishlist.removed' | t | json }},
        "wl_empty": {{ 'wishlist.empty' | t | json }},
        "wl_move": {{ 'wishlist.move_to_cart' | t | json }},
        "loading": {{ 'general.loading' | t | json }},
        "copied": {{ 'general.copied' | t | json }},
        "copy_failed": {{ 'general.copy_failed' | t | json }},
        "qv_error": {{ 'products.quick_view_error' | t | json }}
      }
    }
  </script>
</body>
</html>
