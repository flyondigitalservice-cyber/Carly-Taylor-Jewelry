<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_background }}">
  <title>{{ shop.name }} — {{ 'password.title' | t }}</title>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
  {%- style -%}
    :root{
      --c-bg: {{ settings.color_background }}; --c-surface: {{ settings.color_surface }};
      --c-text: {{ settings.color_text }}; --c-muted: {{ settings.color_text_muted }};
      --c-accent: {{ settings.color_accent }}; --c-btn: {{ settings.color_button }};
      --c-btn-text: {{ settings.color_button_text }}; --c-border: {{ settings.color_border }};
      --c-sale: {{ settings.color_sale }}; --c-success: {{ settings.color_success }}; --c-star: {{ settings.color_star }};
      --page-w: {{ settings.page_width }}px; --sec-gap: {{ settings.space_sections }}px;
      --body-size: {{ settings.type_body_scale }}px; --head-scale: {{ settings.type_heading_scale | divided_by: 100.0 }};
      --font-head: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
      --font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
      --ratio: 1/1; --logo-w: {{ settings.logo_width }}px; --radius: 14px;
      --shadow-1: 0 1px 2px rgba(30,26,22,.05), 0 8px 24px -12px rgba(30,26,22,.14);
      --shadow-2: 0 12px 40px -12px rgba(30,26,22,.22); --ease: cubic-bezier(.22,.61,.21,1);
    }
  {%- endstyle -%}
</head>
<body class="template-password">
  {%- render 'icon-set' -%}
  {{ content_for_layout }}
</body>
</html>
