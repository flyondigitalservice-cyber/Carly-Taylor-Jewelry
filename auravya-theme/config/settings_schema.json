[
  {
    "theme_name": "Auravya",
    "theme_version": "1.0.0",
    "theme_author": "Auravya Studio",
    "theme_documentation_url": "https://github.com/auravya/theme",
    "theme_support_url": "https://github.com/auravya/theme/support"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "header",
        "content": "Logo"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image",
        "info": "Shown in header + footer. SVG/PNG recommended."
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 260,
        "step": 5,
        "unit": "px",
        "label": "Logo width",
        "default": 150
      },
      {
        "type": "text",
        "id": "logo_text",
        "label": "Wordmark text",
        "default": "AURAVYA",
        "info": "Used when no logo image is uploaded."
      },
      {
        "type": "text",
        "id": "tagline",
        "label": "Tagline",
        "default": "925 Silver, Made Personal"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "32 x 32 px minimum"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#FBF8F2"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Cards & panels",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#221D18"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Muted text",
        "default": "#6E655C"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (links, highlights)",
        "default": "#9A6B2F"
      },
      {
        "type": "color",
        "id": "color_button",
        "label": "Button background",
        "default": "#1E1A16"
      },
      {
        "type": "color",
        "id": "color_button_text",
        "label": "Button text",
        "default": "#FBF8F2"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Borders & lines",
        "default": "#E4DCD1"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale price",
        "default": "#A3271E"
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "In stock / success",
        "default": "#2F7D4F"
      },
      {
        "type": "color",
        "id": "color_star",
        "label": "Rating stars",
        "default": "#C99A3F"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Headings",
        "default": "cormorant_garamond_n5"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body",
        "default": "jost_n4"
      },
      {
        "type": "range",
        "id": "type_body_scale",
        "min": 13,
        "max": 19,
        "step": 1,
        "unit": "px",
        "label": "Body base size",
        "default": 15
      },
      {
        "type": "range",
        "id": "type_heading_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Heading scale",
        "default": 100
      },
      {
        "type": "checkbox",
        "id": "type_uppercase_buttons",
        "label": "Uppercase buttons & labels",
        "default": true
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1080,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Page width",
        "default": 1360
      },
      {
        "type": "range",
        "id": "space_sections",
        "min": 40,
        "max": 140,
        "step": 5,
        "unit": "px",
        "label": "Space between sections",
        "default": 80
      },
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Product image ratio",
        "options": [
          {
            "value": "square",
            "label": "Square 1:1"
          },
          {
            "value": "portrait",
            "label": "Portrait 4:5"
          },
          {
            "value": "adaptive",
            "label": "Adaptive to image"
          }
        ],
        "default": "square"
      },
      {
        "type": "select",
        "id": "card_style",
        "label": "Product card style",
        "options": [
          {
            "value": "clean",
            "label": "Clean (no border)"
          },
          {
            "value": "card",
            "label": "Card with border"
          }
        ],
        "default": "clean"
      },
      {
        "type": "checkbox",
        "id": "card_hover_swap",
        "label": "Swap to second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_swatches",
        "label": "Show coating swatches on cards",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show material on cards",
        "default": true
      }
    ]
  },
  {
    "name": "Header & announcement",
    "settings": [
      {
        "type": "checkbox",
        "id": "header_sticky",
        "label": "Sticky header",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "header_mega_menu",
        "label": "Enable mega menu (desktop)",
        "default": true
      },
      {
        "type": "text",
        "id": "mega_menu_trigger",
        "label": "Mega menu link label",
        "default": "Shop All",
        "info": "The menu item that opens the mega panel."
      },
      {
        "type": "textarea",
        "id": "announcement_messages",
        "label": "Announcement messages",
        "default": "Free shipping across India on orders above ₹1,499|Easy 15-day returns, no questions asked|Lifetime plating warranty on every piece",
        "info": "One message per line. Rotates automatically."
      },
      {
        "type": "range",
        "id": "announcement_rotate",
        "min": 0,
        "max": 12,
        "step": 1,
        "unit": "s",
        "label": "Rotate every",
        "info": "0 = no rotation",
        "default": 5
      }
    ]
  },
  {
    "name": "Product options",
    "settings": [
      {
        "type": "paragraph",
        "content": "Map your Shopify option names so the theme renders the right control: colour swatches, size pills, engraving, gift wrap and price add-ons."
      },
      {
        "type": "text",
        "id": "swatch_option_names",
        "label": "Swatch option names",
        "default": "Coating, Color, Colour, Finish, Plating",
        "info": "Comma separated. Rendered as colour swatches."
      },
      {
        "type": "text",
        "id": "size_option_names",
        "label": "Size option names",
        "default": "Size, Ring Size, Bracelet Size, Chain Length, Length",
        "info": "Comma separated. Rendered as size pills with size guide."
      },
      {
        "type": "textarea",
        "id": "swatch_map",
        "label": "Swatch colours",
        "default": "Silver: #E8E8E6\nRhodium: #DDE1E4\nGold Plated: #D9A441\n18K Gold Vermeil: #C9992E\nRose Gold: #D8A0A0\nOxidised: #5B5B60\nBlack Rhodium: #3A3A3E",
        "info": "One per line:  Option value: #hexcode  (or an image URL)"
      },
      {
        "type": "checkbox",
        "id": "enable_coating_tint",
        "label": "Metal-tint photo when a coating has no own image",
        "default": true,
        "info": "Until you upload a photo per coating, the swatch colour is blended over the photo so Rose Gold looks rose gold. Turn off any time."
      },
      {
        "type": "checkbox",
        "id": "enable_size_guide",
        "label": "Show size guide link + modal",
        "default": true
      },
      {
        "type": "text",
        "id": "size_guide_page",
        "label": "Size guide page handle",
        "default": "size-guide",
        "info": "Page content is shown inside the modal."
      },
      {
        "type": "checkbox",
        "id": "enable_engraving",
        "label": "Enable engraving (line item property)",
        "default": true
      },
      {
        "type": "number",
        "id": "engraving_price",
        "label": "Engraving add-on price",
        "default": 199,
        "unit": "₹"
      },
      {
        "type": "number",
        "id": "price_filter_cap",
        "label": "Price filter ceiling (fallback)",
        "default": 15000,
        "unit": "₹",
        "info": "The filter normally auto-computes its maximum from product prices; this is only used when a collection is empty."
      },
      {
        "type": "range",
        "id": "engraving_max_chars",
        "min": 5,
        "max": 40,
        "step": 1,
        "label": "Max engraving characters",
        "default": 20
      },
      {
        "type": "checkbox",
        "id": "enable_gift_wrap",
        "label": "Enable gift wrap add-on",
        "default": true
      },
      {
        "type": "range",
        "id": "gift_wrap_price",
        "min": 0,
        "max": 999,
        "step": 25,
        "unit": "₹",
        "label": "Gift wrap price",
        "default": 149
      },
      {
        "type": "checkbox",
        "id": "enable_cod",
        "label": "Show Cash on Delivery notice",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_pincode_check",
        "label": "Show pincode delivery checker",
        "default": true
      }
    ]
  },
  {
    "name": "Badges & labels",
    "settings": [
      {
        "type": "text",
        "id": "badge_sale_text",
        "label": "Sale badge",
        "default": "Sale"
      },
      {
        "type": "checkbox",
        "id": "badge_sale_percent",
        "label": "Show % off on sale badge",
        "default": true
      },
      {
        "type": "text",
        "id": "badge_soldout_text",
        "label": "Sold out badge",
        "default": "Sold out"
      },
      {
        "type": "text",
        "id": "badge_new_text",
        "label": "New badge",
        "default": "New"
      },
      {
        "type": "range",
        "id": "badge_new_days",
        "min": 7,
        "max": 90,
        "step": 7,
        "unit": "days",
        "label": "Product is 'New' for",
        "default": 30
      },
      {
        "type": "text",
        "id": "badge_bestseller_text",
        "label": "Bestseller badge",
        "default": "Bestseller"
      },
      {
        "type": "text",
        "id": "badge_bestseller_tag",
        "label": "Bestseller product tag",
        "default": "bestseller"
      },
      {
        "type": "text",
        "id": "badge_lowstock_text",
        "label": "Low stock note",
        "default": "Only {{ count }} left — order soon"
      },
      {
        "type": "range",
        "id": "lowstock_threshold",
        "min": 2,
        "max": 10,
        "step": 1,
        "label": "Low stock threshold",
        "default": 5
      }
    ]
  },
  {
    "name": "Cart & wishlist",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_drawer_enable",
        "label": "Open cart drawer on add",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_free_shipping",
        "label": "Free shipping progress bar",
        "default": true
      },
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "min": 0,
        "max": 9999,
        "step": 100,
        "unit": "₹",
        "label": "Free shipping threshold",
        "default": 1499
      },
      {
        "type": "checkbox",
        "id": "cart_note_enable",
        "label": "Order note in cart",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "wishlist_enable",
        "label": "Enable wishlist",
        "default": true
      },
      {
        "type": "text",
        "id": "wishlist_label",
        "label": "Wishlist label",
        "default": "Wishlist"
      }
    ]
  },
  {
    "name": "Reviews",
    "settings": [
      {
        "type": "checkbox",
        "id": "reviews_enable",
        "label": "Show ratings & reviews",
        "default": true
      },
      {
        "type": "select",
        "id": "reviews_provider",
        "label": "Reviews provider",
        "options": [
          {
            "value": "shopify",
            "label": "Shopify Product Reviews"
          },
          {
            "value": "judgeme",
            "label": "Judge.me"
          },
          {
            "value": "metafield",
            "label": "Metafield only (no app)"
          }
        ],
        "default": "shopify"
      }
    ]
  },
  {
    "name": "Trust & policies",
    "settings": [
      {
        "type": "textarea",
        "id": "trust_items",
        "label": "Trust bar items",
        "default": "Lifetime Plating Warranty|7-Day Moneyback|Premium Packaging|BIS-Registered 925 Silver",
        "info": "One per line, shown with icons in order."
      },
      {
        "type": "textarea",
        "id": "cod_note",
        "label": "COD note",
        "default": "Cash on Delivery available across India for orders under ₹10,000."
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "text",
        "id": "social_whatsapp",
        "label": "WhatsApp number",
        "info": "Digits only, with country code. e.g. 919876543210"
      }
    ]
  }
]