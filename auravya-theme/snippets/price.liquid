{%- comment -%}
  Price display. Args: product | variant, show_compare (bool), size ('sm'|'md'|'lg'), class
{%- endcomment -%}
{%- assign p = variant | default: product.selected_or_first_available_variant | default: product -%}
{%- assign show_compare = show_compare | default: true -%}
<div class="price price--{{ size | default: 'md' }} {{ class }}" data-price-wrap>
  {%- if p.compare_at_price > p.price and show_compare -%}
    <span class="price__sale">{{ p.price | money }}</span>
    <s class="price__compare">{{ p.compare_at_price | money }}</s>
    <span class="price__off">-{{ p.compare_at_price | minus: p.price | times: 100.0 | divided_by: p.compare_at_price | round }}%</span>
  {%- else -%}
    <span class="price__regular">{{ p.price | money }}</span>
  {%- endif -%}
  {%- if p.unit_price -%}
    <span class="price__unit">{{ p.unit_price | money }} {{ 'accessibility.unit_price_separator' | t }} {{ p.unit_price_measurement.reference_unit }}</span>
  {%- endif -%}
  {%- unless p.available -%}<span class="price__soldout">{{ 'products.sold_out' | t }}</span>{%- endunless -%}
</div>
