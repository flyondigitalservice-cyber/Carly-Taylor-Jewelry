{%- comment -%} Slide-out cart drawer (AJAX). Content injected by cart.js from /cart.js {%- endcomment -%}
<div class="drawer" id="CartDrawer" data-drawer="cart" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}" hidden>
  <div class="drawer__scrim" data-drawer-close></div>
  <aside class="drawer__panel drawer__panel--right">
    <header class="drawer__head">
      <h2 class="drawer__title"><svg class="icon"><use href="#i-bag"/></svg>{{ 'cart.title' | t }} <span class="drawer__count" data-cart-count>0</span></h2>
      <button class="iconbtn" data-drawer-close aria-label="{{ 'general.close' | t }}"><svg class="icon"><use href="#i-close"/></svg></button>
    </header>

    {%- if settings.cart_free_shipping -%}
      <div class="shipbar" data-shipbar>
        <div class="shipbar__label" data-shipbar-label>{{ 'cart.free_shipping_progress' | t: amount: '—' }}</div>
        <div class="shipbar__track"><span class="shipbar__fill" data-shipbar-fill style="width:0%"></span></div>
      </div>
    {%- endif -%}

    <div class="drawer__body" data-cart-items>
      <div class="drawer__empty">
        <svg class="icon drawer__emptyicon"><use href="#i-bag"/></svg>
        <p>{{ 'cart.empty' | t }}</p>
        <a class="btn" href="{{ routes.all_products_collection_url }}" data-drawer-close>{{ 'cart.empty_cta' | t }}</a>
      </div>
    </div>

    <footer class="drawer__foot">
      {%- if settings.cart_note_enable -%}
        <details class="acc acc--sm">
          <summary class="acc__head"><span class="acc__title">{{ 'cart.note' | t }}</span><svg class="icon acc__chev"><use href="#i-chev-d"/></svg></summary>
          <div class="acc__body"><div class="acc__inner">
            <textarea class="input" rows="2" placeholder="{{ 'cart.note_placeholder' | t }}" data-cart-note></textarea>
          </div></div>
        </details>
      {%- endif -%}
      <div class="drawer__subtotal">
        <span>{{ 'cart.subtotal' | t }}</span>
        <strong data-cart-total>{{ 0 | money }}</strong>
      </div>
      <p class="drawer__fineprint">{{ 'cart.subtotal_note' | t }}</p>
      <button class="btn btn--lg btn--block" data-checkout>{{ 'cart.checkout' | t }}</button>
      <a class="drawer__viewcart link-underline" href="{{ routes.cart_url }}">{{ 'cart.view_cart' | t }}</a>
    </footer>
  </aside>
</div>
