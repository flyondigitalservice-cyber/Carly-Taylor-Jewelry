{%- comment -%} Slide-out cart drawer (AJAX). Line items are rendered by cart.js from /cart.js {%- endcomment -%}
<div class="drawer{% if cart.item_count == 0 %} is-empty{% endif %}" id="CartDrawer" data-drawer="cart" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}" hidden>
  <div class="drawer__scrim" data-drawer-close></div>
  <aside class="drawer__panel drawer__panel--right">
    <header class="drawer__head">
      <h2 class="drawer__title"><svg class="icon"><use href="#i-bag"/></svg>{{ 'cart.title' | t }} <span class="drawer__count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span></h2>
      <button class="iconbtn" type="button" data-drawer-close aria-label="{{ 'general.close' | t }}"><svg class="icon"><use href="#i-close"/></svg></button>
    </header>

    {%- if settings.cart_free_shipping and settings.free_shipping_threshold > 0 -%}
      {%- render 'free-shipping-bar' -%}
    {%- endif -%}

    <div class="drawer__body" data-cart-items>
      {%- if cart.item_count == 0 -%}
        <div class="drawer__empty">
          <svg class="icon drawer__emptyicon"><use href="#i-bag"/></svg>
          <p>{{ 'cart.empty' | t }}</p>
          <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.empty_cta' | t }}</a>
        </div>
      {%- else -%}
        {%- for item in cart.items -%}{%- render 'cart-item', item: item -%}{%- endfor -%}
      {%- endif -%}
    </div>

    <footer class="drawer__foot">
      {%- if settings.cart_note_enable -%}
        <details class="acc acc--sm">
          <summary class="acc__head"><span class="acc__title">{{ 'cart.note' | t }}</span><svg class="icon acc__chev"><use href="#i-chev-d"/></svg></summary>
          <div class="acc__body"><div class="acc__inner">
            <textarea class="input" rows="2" placeholder="{{ 'cart.note_placeholder' | t }}" aria-label="{{ 'cart.note' | t }}" data-cart-note>{{ cart.note }}</textarea>
          </div></div>
        </details>
      {%- endif -%}
      <p class="drawer__savings" data-cart-savings{% if cart.total_discount == 0 %} hidden{% endif %}>
        <span>{{ 'cart.savings' | t }}</span>
        <strong data-cart-savings-value>{%- render 'money', amount: cart.total_discount -%}</strong>
      </p>
      <div class="drawer__subtotal">
        <span>{{ 'cart.subtotal' | t }}</span>
        <strong data-cart-total>{%- render 'money', amount: cart.total_price -%}</strong>
      </div>
      <p class="drawer__fineprint">{{ 'cart.subtotal_note' | t }}</p>
      <form action="{{ routes.cart_url }}" method="post">
        <button class="btn btn--lg btn--block" type="submit" name="checkout"><svg class="icon"><use href="#i-lock"/></svg>{{ 'cart.checkout' | t }}</button>
      </form>
      {%- if settings.enable_cod -%}<p class="drawer__cod"><svg class="icon"><use href="#i-cash"/></svg>{{ 'cart.cod_available' | t }}</p>{%- endif -%}
      <a class="drawer__viewcart link-underline" href="{{ routes.cart_url }}">{{ 'cart.view_cart' | t }}</a>
    </footer>
  </aside>
</div>
