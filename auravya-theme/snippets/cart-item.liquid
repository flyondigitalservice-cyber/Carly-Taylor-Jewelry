{%- comment -%} Cart line item. Args: item, compact (bool) {%- endcomment -%}
<div class="citem" data-cart-item="{{ item.key }}" data-key="{{ item.key }}">
  <a class="citem__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}<img src="{{ item.image | image_url: width: 200 }}" alt="" width="100" height="100" loading="lazy">{%- endif -%}
  </a>
  <div class="citem__body">
    <div class="citem__top">
      <a class="citem__title" href="{{ item.url }}">{{ item.product.title }}
        {%- if item.variant.title != 'Default Title' -%}<span class="citem__variant">{{ item.variant.title }}</span>{%- endif -%}
      </a>
      <button class="iconbtn citem__remove" data-remove-item="{{ item.key }}" aria-label="{{ 'general.remove' | t }}">
        <svg class="icon"><use href="#i-trash"/></svg>
      </button>
    </div>

    {%- if item.properties.size > 0 -%}
      <ul class="citem__props">
        {%- for prop in item.properties -%}
          {%- unless prop.last == blank -%}<li><strong>{{ prop.first }}:</strong> {{ prop.last }}</li>{%- endunless -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="citem__bottom">
      {%- assign ci_qty_id = item.key | replace: ':', '-' -%}
      {%- render 'quantity-input', qty: item.quantity, min: 0, size: 'sm', input_name: 'updates[]', id: ci_qty_id -%}
      <div class="citem__price">
        {%- if item.original_line_price > item.final_line_price -%}
          <s>{{ item.original_line_price | money }}</s>
        {%- endif -%}
        <strong>{{ item.final_line_price | money }}</strong>
      </div>
    </div>
  </div>
</div>
