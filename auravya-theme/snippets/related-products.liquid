{%- comment -%} Related products carousel. Args: product, collection, limit {%- endcomment -%}
{%- assign limit = limit | default: 6 -%}
{%- assign related_source = collection | default: collections['all'] -%}
<section class="related section-gap">
  <div class="container">
    <div class="sechead sechead--split">
      <h2 class="h3">{{ 'products.related' | t }}</h2>
      <div class="sechead__nav">
        <button class="iconbtn" data-carousel-prev aria-label="{{ 'general.previous' | t }}"><svg class="icon"><use href="#i-chev-l"/></svg></button>
        <button class="iconbtn" data-carousel-next aria-label="{{ 'general.next' | t }}"><svg class="icon"><use href="#i-chev-r"/></svg></button>
      </div>
    </div>
    <div class="carousel" data-carousel>
      <div class="carousel__track">
        {%- assign shown = 0 -%}
        {%- for p in related_source.products limit: 24 -%}
          {%- if p.id != product.id -%}
            <div class="carousel__slide">{%- render 'product-card', product: p, index: forloop.index0 -%}</div>
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if shown < limit -%}
          {%- for p in collections['all'].products limit: 12 -%}
            {%- if p.id != product.id -%}
              <div class="carousel__slide">{%- render 'product-card', product: p, index: forloop.index0 -%}</div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
