<section class="cartpage container section-gap">
  {%- render 'breadcrumbs' -%}
  <h1 class="h1">{{ 'cart.title' | t }} <span class="cartpage__count">({{ cart.item_count }})</span></h1>

  {%- if cart.item_count == 0 -%}
    <div class="empty">
      <svg class="icon empty__icon"><use href="#i-bag"/></svg>
      <p>{{ 'cart.empty' | t }}</p>
      <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.empty_cta' | t }}</a>
    </div>
  {%- else -%}
    {%- if settings.cart_free_shipping and settings.free_shipping_threshold > 0 -%}
      {%- render 'free-shipping-bar', class: 'shipbar--page' -%}
    {%- endif -%}

    <div class="cartpage__grid">
      <div class="cartpage__items">
        {%- for item in cart.items -%}
          {%- render 'cart-item', item: item -%}
        {%- endfor -%}
        <a class="link-underline cartpage__continue" href="{{ routes.all_products_collection_url }}"><svg class="icon"><use href="#i-chev-l"/></svg> {{ 'general.continue_shopping' | t }}</a>
      </div>
      <aside class="cartpage__summary">
        <form action="{{ routes.cart_url }}" method="post" novalidate>
          {%- if settings.cart_note_enable -%}
            <label class="field"><span>{{ 'cart.note' | t }}</span>
              <textarea class="input" rows="3" name="note" placeholder="{{ 'cart.note_placeholder' | t }}" data-cart-note>{{ cart.note }}</textarea>
            </label>
          {%- endif -%}
          <div class="cartpage__lines">
            <p><span>{{ 'cart.items_total' | t }}</span><span>{%- render 'money', amount: cart.items_subtotal_price -%}</span></p>
            {%- for discount in cart.cart_level_discount_applications -%}
              <p class="ok"><span>{{ discount.title | escape }}</span><span>−{%- render 'money', amount: discount.total_allocated_amount -%}</span></p>
            {%- endfor -%}
            {%- if cart.total_discount > 0 -%}
              <p class="ok"><span>{{ 'cart.savings' | t }}</span><span>{%- render 'money', amount: cart.total_discount -%}</span></p>
            {%- endif -%}
          </div>
          <div class="drawer__subtotal"><span>{{ 'cart.subtotal' | t }}</span><strong>{%- render 'money', amount: cart.total_price -%}</strong></div>
          <p class="drawer__fineprint">{{ 'cart.subtotal_note' | t }}</p>
          {%- if settings.enable_cod -%}<p class="pform__cod"><svg class="icon"><use href="#i-cash"/></svg>{{ settings.cod_note }}</p>{%- endif -%}
          <button class="btn btn--lg btn--block" type="submit" name="checkout"><svg class="icon"><use href="#i-lock"/></svg>{{ 'cart.checkout' | t }}</button>
          {%- if additional_checkout_buttons -%}
            <div class="cartpage__dynamic">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        </form>
        <p class="cartpage__secure"><svg class="icon"><use href="#i-shield"/></svg>{{ 'cart.secure' | t }}</p>
        {%- render 'payment-icons' -%}
      </aside>
    </div>
  {%- endif -%}
</section>

{% schema %}
{ "name": "Cart page", "settings": [] }
{% endschema %}
