<article class="article-sec container section-gap">
  {%- render 'breadcrumbs', article: article -%}
  <header class="article-sec__head">
    <span class="eyebrow">{{ article.tags.first | default: blog.title }}</span>
    <h1 class="h1">{{ article.title }}</h1>
    <div class="article-sec__meta">
      <span>{{ article.author }}</span>·<time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d %B %Y' }}</time>·<span>{{ article.content | strip_html | size | divided_by: 1000 | at_least: 1 }} min read</span>
    </div>
  </header>
  {%- if article.image -%}
    <figure class="article-sec__hero">
      <img src="{{ article.image | image_url: width: 1800 }}" alt="{{ article.image.alt | default: article.title | escape }}" width="1800" height="900">
    </figure>
  {%- endif -%}
  <div class="rte article-sec__body">{{ article.content }}</div>

  {%- if blog.comments_enabled? -%}
    <section class="article-sec__comments" id="comments">
      <h2 class="h3">{{ article.comments_count }} comments</h2>
      {%- paginate article.comments by 5 -%}
        {%- for comment in article.comments -%}
          <div class="comment">
            <strong>{{ comment.author }}</strong><time>{{ comment.created_at | date: '%d %b %Y' }}</time>
            <div class="rte">{{ comment.content }}</div>
          </div>
        {%- endfor -%}
        {%- render 'pagination', paginate: paginate -%}
      {%- endpaginate -%}
      {%- form 'new_comment', article, class: 'cform cform--sm' -%}
        {%- if form.posted_successfully? and article.moderated? -%}<p class="formnote formnote--ok">Comment submitted for moderation.</p>{%- endif -%}
        {%- if form.posted_successfully? and article.moderated? == false -%}<p class="formnote formnote--ok">Comment posted!</p>{%- endif -%}
        <div class="cform__row">
          <label class="field"><span>Name</span><input class="input" type="text" name="comment[author]" required></label>
          <label class="field"><span>Email</span><input class="input" type="email" name="comment[email]" required></label>
        </div>
        <label class="field"><span>Comment</span><textarea class="input" rows="4" name="comment[content]" required></textarea></label>
        <button class="btn" type="submit">Post comment</button>
      {%- endform -%}
    </section>
  {%- endif -%}

  <div class="article-sec__nav">
    {%- if blog.previous_article -%}<a class="btn btn--ghost" href="{{ blog.previous_article.url }}"><svg class="icon"><use href="#i-chev-l"/></svg> Previous</a>{%- endif -%}
    {%- if blog.next_article -%}<a class="btn btn--ghost" href="{{ blog.next_article.url }}">Next <svg class="icon"><use href="#i-chev-r"/></svg></a>{%- endif -%}
  </div>
  {%- render 'social-share' -%}
</article>

{% schema %}
{ "name": "Article page", "settings": [] }
{% endschema %}
