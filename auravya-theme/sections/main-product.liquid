{%- comment -%}
  Product page. Gallery on the left, a buy box built from blocks on the right — every row can be
  reordered, removed or added from the theme editor (including review / app blocks).
{%- endcomment -%}
{%- assign current = product.selected_or_first_available_variant -%}
<section class="pdp container section-gap-narrow" data-product-page data-product-json='{{ product | json | escape }}'>
  <div class="pdp__grid pdp__grid--{{ section.settings.layout }}">
    <div class="pdp__gallery">
      {%- render 'product-media', product: product -%}
      {%- render 'product-badge', product: product, class: 'pdp__badges' -%}
    </div>

    <div class="pdp__buy">
      {%- if section.settings.show_breadcrumbs -%}{%- render 'breadcrumbs', product: product, collection: collection -%}{%- endif -%}

      {%- assign accs_open = false -%}
      {%- for block in section.blocks -%}
        {%- assign is_acc = false -%}
        {%- if block.type == 'description' or block.type == 'collapsible_tab' -%}{%- assign is_acc = true -%}{%- endif -%}
        {%- if is_acc and accs_open == false -%}<div class="pdp__accs">{%- assign accs_open = true -%}{%- endif -%}
        {%- if is_acc == false and accs_open -%}</div>{%- assign accs_open = false -%}{%- endif -%}

        {%- case block.type -%}
          {%- when '@app' -%}
            <div class="pdp__block pdp__block--app">{% render block %}</div>

          {%- when 'title' -%}
            <div class="pdp__head" {{ block.shopify_attributes }}>
              {%- if block.settings.show_material -%}
                <span class="pdp__vendor">{{ product.metafields.custom.material | default: settings.default_material }}</span>
              {%- endif -%}
              <h1 class="pdp__title">{{ product.title }}</h1>
            </div>

          {%- when 'rating' -%}
            {%- if settings.reviews_enable -%}
              <a class="pdp__ratinglink" href="#Reviews-{{ section.id }}" {{ block.shopify_attributes }}>
                {%- render 'rating', product: product, size: 'sm' -%}
              </a>
            {%- endif -%}

          {%- when 'price' -%}
            <div class="pdp__pricebox" {{ block.shopify_attributes }}>
              {%- render 'price', product: product, size: 'lg' -%}
              {%- if settings.show_tax_note -%}<p class="pdp__taxnote">{{ settings.tax_note_text }}</p>{%- endif -%}
            </div>

          {%- when 'offers' -%}
            {%- assign offer_lines = block.settings.offers | newline_to_br | split: '<br />' -%}
            <div class="offers" {{ block.shopify_attributes }}>
              <p class="offers__head"><svg class="icon"><use href="#i-tag"/></svg>{{ block.settings.heading }}</p>
              <ul class="offers__list">
                {%- for line in offer_lines -%}
                  {%- assign parts = line | strip | split: '|' -%}
                  {%- if parts.size > 0 and parts[0] != blank -%}
                    {%- assign code = parts[0] | strip -%}
                    <li class="offers__item">
                      <span class="offers__text">{{ parts[1] | default: code | strip }}</span>
                      {%- if parts.size > 1 -%}
                        <button type="button" class="offers__code" data-copy-text="{{ code | escape }}" aria-label="{{ 'general.copy_code' | t }}: {{ code | escape }}">
                          {{ code }}<svg class="icon"><use href="#i-copy"/></svg>
                        </button>
                      {%- endif -%}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'buy_buttons' -%}
            <div class="pdp__block" {{ block.shopify_attributes }}>
              {%- render 'product-form', product: product, id_prefix: 'PF' -%}
            </div>

          {%- when 'text' -%}
            <div class="pdp__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- when 'description' -%}
            {%- capture details_html -%}
              <div class="rte">{{ product.description }}</div>
              {%- if product.metafields.custom.dimensions != blank -%}<p class="pdpspec"><strong>{{ 'products.dimensions' | t }}:</strong> {{ product.metafields.custom.dimensions }}</p>{%- endif -%}
              {%- if product.metafields.custom.weight != blank -%}<p class="pdpspec"><strong>{{ 'products.weight' | t }}:</strong> {{ product.metafields.custom.weight }}</p>{%- endif -%}
              {%- if product.metafields.custom.stone != blank -%}<p class="pdpspec"><strong>{{ 'products.stone' | t }}:</strong> {{ product.metafields.custom.stone }}</p>{%- endif -%}
              {%- if product.metafields.custom.plating != blank -%}<p class="pdpspec"><strong>{{ 'products.plating' | t }}:</strong> {{ product.metafields.custom.plating }}</p>{%- endif -%}
            {%- endcapture -%}
            {%- assign acc_title = 'products.details' | t -%}
            {%- if block.settings.heading != blank -%}{%- assign acc_title = block.settings.heading -%}{%- endif -%}
            <div {{ block.shopify_attributes }}>
              {%- render 'collapsible-row', title: acc_title, content: details_html, open: block.settings.open, icon: block.settings.icon -%}
            </div>

          {%- when 'collapsible_tab' -%}
            {%- capture tab_html -%}
              {%- if block.settings.content != blank -%}<div class="rte">{{ block.settings.content }}</div>{%- endif -%}
              {%- if block.settings.page != blank -%}<div class="rte">{{ block.settings.page.content }}</div>{%- endif -%}
            {%- endcapture -%}
            {%- if tab_html != blank -%}
              <div {{ block.shopify_attributes }}>
                {%- render 'collapsible-row', title: block.settings.heading, content: tab_html, open: block.settings.open, icon: block.settings.icon -%}
              </div>
            {%- endif -%}

          {%- when 'share' -%}
            <div {{ block.shopify_attributes }}>{%- render 'social-share' -%}</div>

          {%- when 'custom_liquid' -%}
            <div class="pdp__block" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
        {%- endcase -%}
      {%- endfor -%}
      {%- if accs_open -%}</div>{%- endif -%}
    </div>
  </div>

  {%- if settings.reviews_enable and section.settings.show_reviews -%}
    <div class="pdp__reviews" id="Reviews-{{ section.id }}">
      <div class="sechead sechead--split">
        <h2 class="h3">{{ 'products.reviews' | t }}</h2>
      </div>
      {%- if settings.reviews_provider == 'judgeme' -%}
        <div class="jdgm-widget jdgm-review-widget jdgm-outside-widget" data-id="{{ product.id }}">{{ product.metafields.judgeme.widget }}</div>
      {%- endif -%}
      {%- assign rmf = product.metafields.reviews.rating -%}
      {%- assign rc = product.metafields.reviews.rating_count.value | default: 0 -%}
      {%- if rmf != blank and rc > 0 -%}
        <div class="revsummary">
          <div class="revsummary__score">
            <strong>{{ rmf.value.rating | round: 1 }}</strong>
            {%- render 'rating', product: product, show_count: false, size: 'md' -%}
            <span>{{ 'products.based_on' | t: count: rc }}</span>
          </div>
        </div>
      {%- elsif settings.reviews_provider != 'judgeme' -%}
        <p class="pdp__noreviews">{{ 'products.no_reviews' | t }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

<div class="pdp__stickybar" data-sticky-bar>
  <div class="pdp__stickybar-inner container">
    <div class="pdp__stickyinfo">
      <strong>{{ product.title | truncate: 40 }}</strong>
      {%- render 'price', product: product, size: 'sm', variant: current -%}
    </div>
    <button class="btn" type="button" data-sticky-add {% unless current.available %}disabled{% endunless %}>
      {%- if current.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
    </button>
  </div>
</div>

{%- comment -%} Recently viewed is stored client-side; the section below reads it. {%- endcomment -%}
<script>
  try {
    var rvKey = 'auravya_recent', rv = JSON.parse(localStorage.getItem(rvKey) || '[]');
    rv = [{{ product.handle | json }}].concat(rv.filter(function (h) { return h !== {{ product.handle | json }}; })).slice(0, 12);
    localStorage.setItem(rvKey, JSON.stringify(rv));
  } catch (e) {}
</script>

{% schema %}
{
  "name": "Product page",
  "settings": [
    { "type": "select", "id": "layout", "label": "Gallery layout", "options": [
      { "value": "sticky", "label": "Sticky gallery (2 columns)" }, { "value": "stack", "label": "Stacked" }
    ], "default": "sticky" },
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "checkbox", "id": "show_reviews", "label": "Show reviews area under the product", "default": true, "info": "Ratings come from Judge.me or Shopify's standard reviews metafields. Other review apps can be added as app blocks." }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "title", "name": "Title", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_material", "label": "Show material above the title", "default": true }
    ] },
    { "type": "rating", "name": "Star rating", "limit": 1, "settings": [] },
    { "type": "price", "name": "Price", "limit": 1, "settings": [] },
    { "type": "offers", "name": "Available offers", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Available offers" },
      { "type": "textarea", "id": "offers", "label": "Offers", "default": "SILVER10 | Flat 10% off on your first order\nFESTIVE500 | ₹500 off on orders above ₹3,999\nPREPAID | Extra 5% off on UPI & card payments", "info": "One offer per line: CODE | description. Customers can tap a code to copy it. Create the matching discounts in Shopify → Discounts." }
    ] },
    { "type": "buy_buttons", "name": "Variant picker & buy buttons", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Swatches, size pills, engraving, gift wrap, COD note and pincode check are controlled in Theme settings → Product options." }
    ] },
    { "type": "text", "name": "Text", "settings": [
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Handcrafted in 925 sterling silver.</p>" }
    ] },
    { "type": "description", "name": "Description tab", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank for \"Details\"" },
      { "type": "select", "id": "icon", "label": "Icon", "options": [
        { "value": "sparkle", "label": "Sparkle" }, { "value": "cert", "label": "Certificate" }, { "value": "shield", "label": "Shield" },
        { "value": "truck", "label": "Truck" }, { "value": "return", "label": "Return" }, { "value": "gift", "label": "Gift" }, { "value": "ruler", "label": "Ruler" }
      ], "default": "sparkle" },
      { "type": "checkbox", "id": "open", "label": "Open by default", "default": true }
    ] },
    { "type": "collapsible_tab", "name": "Collapsible tab", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Collapsible tab" },
      { "type": "select", "id": "icon", "label": "Icon", "options": [
        { "value": "sparkle", "label": "Sparkle" }, { "value": "cert", "label": "Certificate" }, { "value": "shield", "label": "Shield" },
        { "value": "truck", "label": "Truck" }, { "value": "return", "label": "Return" }, { "value": "gift", "label": "Gift" }, { "value": "ruler", "label": "Ruler" }
      ], "default": "shield" },
      { "type": "richtext", "id": "content", "label": "Content", "info": "Tip: connect a product metafield with the dynamic source button to show per-product text." },
      { "type": "page", "id": "page", "label": "Or show content from a page" },
      { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
    ] },
    { "type": "share", "name": "Share buttons", "limit": 1, "settings": [] },
    { "type": "custom_liquid", "name": "Custom Liquid", "settings": [
      { "type": "liquid", "id": "custom_liquid", "label": "Custom Liquid" }
    ] }
  ]
}
{% endschema %}
