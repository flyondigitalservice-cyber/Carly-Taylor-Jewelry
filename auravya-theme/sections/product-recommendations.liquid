{%- comment -%}
  "You may also love" — powered by Shopify's product recommendations.
  The placeholder is filled by product.js from /recommendations/products?section_id=…
{%- endcomment -%}
<section class="related section-gap" id="Section-{{ section.id }}"{% unless recommendations.performed and recommendations.products_count > 0 %} hidden{% endunless %}>
  <div class="container">
    <div class="sechead sechead--split">
      <div>
        {%- if section.settings.subheading != blank -%}<span class="eyebrow">{{ section.settings.subheading }}</span>{%- endif -%}
        <h2 class="h3">{{ section.settings.heading }}</h2>
      </div>
      <div class="sechead__nav">
        <button class="iconbtn" type="button" data-carousel-prev aria-label="{{ 'general.previous' | t }}"><svg class="icon"><use href="#i-chev-l"/></svg></button>
        <button class="iconbtn" type="button" data-carousel-next aria-label="{{ 'general.next' | t }}"><svg class="icon"><use href="#i-chev-r"/></svg></button>
      </div>
    </div>
    <div class="carousel" data-recommendations data-product-id="{{ product.id }}" data-limit="{{ section.settings.limit }}" data-section-id="{{ section.id }}">
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        <div class="carousel__track" data-carousel-track>
          {%- for rec in recommendations.products -%}
            <div class="carousel__slide">{%- render 'product-card', product: rec -%}</div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "paragraph", "content": "Recommendations are generated by Shopify from your order history and product data. They appear once you have a few products and orders." },
    { "type": "text", "id": "subheading", "label": "Eyebrow", "default": "Complete the look" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also love" },
    { "type": "range", "id": "limit", "min": 4, "max": 10, "step": 1, "label": "Products to show", "default": 8 }
  ]
}
{% endschema %}
