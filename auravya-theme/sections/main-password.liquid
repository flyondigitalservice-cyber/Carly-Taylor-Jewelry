<section class="pwpage">
  <div class="pwpage__inner">
    <span class="wordmark">{{ settings.logo_text | default: shop.name }}</span>
    <h1 class="h1">{{ 'password.title' | t }}</h1>
    <p>{{ 'password.subtitle' | t }}</p>
    <form class="newsform newsform--center" method="post" action="/contact#newsletter" novalidate data-newsletter>
      <input class="input" type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" required aria-label="Email">
      <button class="btn" type="submit">{{ 'newsletter.button' | t }}</button>
      <p class="newsform__msg" role="status"></p>
    </form>
    {%- form 'storefront_password', class: 'pwform' -%}
      <details class="acc acc--sm">
        <summary class="acc__head"><span class="acc__title">{{ 'password.enter' | t }}</span><svg class="icon acc__chev"><use href="#i-chev-d"/></svg></summary>
        <div class="acc__body"><div class="acc__inner">
          <input class="input" type="password" name="password" placeholder="Password" aria-label="Store password">
          <button class="btn btn--sm btn--block" type="submit">Enter</button>
        </div></div>
      </details>
    {%- endform -%}
    {%- render 'social-links', class: 'socials--row socials--center' -%}
  </div>
</section>

{% schema %}
{ "name": "Password page", "settings": [] }
{% endschema %}
