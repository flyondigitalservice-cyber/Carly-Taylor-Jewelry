<section class="pwpage">
  <div class="pwpage__inner">
    <span class="wordmark">{{ settings.logo_text | default: shop.name }}</span>
    <h1 class="h1">{{ 'password.title' | t }}</h1>
    <p>{{ 'password.subtitle' | t }}</p>
    {%- render 'newsletter-form', form_id: 'PasswordNewsletter' -%}
    {%- form 'storefront_password', class: 'pwform' -%}
      <details class="acc acc--sm"{% if form.errors %} open{% endif %}>
        <summary class="acc__head"><span class="acc__title">{{ 'password.enter' | t }}</span><svg class="icon acc__chev"><use href="#i-chev-d"/></svg></summary>
        <div class="acc__body"><div class="acc__inner">
          {%- if form.errors -%}<p class="newsform__msg newsform__msg--err" role="alert">{{ form.errors.messages['form'] }}</p>{%- endif -%}
          <input class="input" type="password" name="password" placeholder="{{ 'password.password' | t }}" aria-label="{{ 'password.password' | t }}" autocomplete="current-password">
          <button class="btn btn--sm btn--block" type="submit">{{ 'password.enter_button' | t }}</button>
        </div></div>
      </details>
    {%- endform -%}
    {%- render 'social-links', class: 'socials--row socials--center' -%}
  </div>
</section>

{% schema %}
{ "name": "Password page", "settings": [] }
{% endschema %}
