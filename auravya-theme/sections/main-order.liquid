<section class="orderpage container section-gap">
  {%- render 'breadcrumbs' -%}
  <div class="account__head">
    <div>
      <span class="eyebrow">{{ 'customer.order_number' | t }} {{ order.name }}</span>
      <h1 class="h1">{{ order.created_at | date: '%d %B %Y' }}</h1>
      <p class="pagehead__sub">Payment: {{ order.financial_status_label }} · Fulfilment: {{ order.fulfillment_status_label | default: 'Pending' }}</p>
    </div>
    <a class="btn btn--ghost btn--sm" href="{{ routes.account_url }}">← {{ 'customer.account_title' | t }}</a>
  </div>

  <div class="account__grid">
    <div class="account__orders">
      {%- for line in order.line_items -%}
        <div class="citem citem--order">
          <div class="citem__media">{%- if line.image -%}<img src="{{ line.image | image_url: width: 200 }}" alt="" width="100" height="100" loading="lazy">{%- endif -%}</div>
          <div class="citem__body">
            <div class="citem__top"><a class="citem__title" href="{{ line.product.url }}">{{ line.product.title }} <span class="citem__variant">{{ line.variant_title }}</span></a><span class="citem__qty">× {{ line.quantity }}</span></div>
            <div class="citem__bottom"><span class="citem__price"><strong>{{ line.final_line_price | money }}</strong></span></div>
          </div>
        </div>
      {%- endfor -%}
      <div class="orderpage__totals">
        <p><span>Subtotal</span><span>{{ order.subtotal_price | money }}</span></p>
        <p><span>Shipping</span><span>{{ order.shipping_price | money }}</span></p>
        {%- for discount in order.discounts -%}<p class="ok"><span>Discount ({{ discount.code }})</span><span>−{{ discount.savings | money }}</span></p>{%- endfor -%}
        <p class="orderpage__grand"><span>Total</span><span>{{ order.total_price | money }}</span></p>
      </div>
    </div>
    <aside class="account__side">
      <div class="contact-card"><svg class="icon"><use href="#i-truck"/></svg><strong>{{ 'customer.shipping_address' | t }}</strong><p>{{ order.shipping_address | format_address }}</p></div>
      <div class="contact-card"><svg class="icon"><use href="#i-cash"/></svg><strong>{{ 'customer.billing_address' | t }}</strong><p>{{ order.billing_address | format_address }}</p></div>
    </aside>
  </div>
</section>

{% schema %}
{ "name": "Order", "settings": [] }
{% endschema %}
