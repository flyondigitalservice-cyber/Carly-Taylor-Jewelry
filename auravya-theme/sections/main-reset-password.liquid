<section class="auth container section-gap">
  <div class="auth__card">
    <h1 class="h2">Reset password</h1>
    {%- form 'reset_customer_password', class: 'cform' -%}
      {%- if form.errors -%}<p class="formnote formnote--err">{{ form.errors | default_errors }}</p>{%- endif -%}
      <label class="field"><span>{{ 'customer.password' | t }}</span><input class="input" type="password" name="customer[password]" required></label>
      <label class="field"><span>{{ 'customer.confirm_password' | t }}</span><input class="input" type="password" name="customer[password_confirmation]" required></label>
      <button class="btn btn--lg btn--block" type="submit">Reset password</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
