<section class="contact-sec container section-gap">
  {%- render 'breadcrumbs' -%}
  <header class="pagehead pagehead--center">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h1 class="h1">{{ page.title | default: section.settings.heading }}</h1>
    {%- if page.content != blank -%}<div class="pagehead__sub rte">{{ page.content }}</div>{%- endif -%}
  </header>

  <div class="contact-sec__grid">
    <div class="contact-sec__form">
      {%- form 'contact', class: 'cform' -%}
        {%- if form.posted_successfully? -%}
          <p class="formnote formnote--ok"><svg class="icon"><use href="#i-check"/></svg>{{ 'contact.success' | t }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="formnote formnote--err">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="cform__row">
          <label class="field">
            <span>{{ 'contact.name' | t }}</span>
            <input class="input" type="text" name="contact[name]" value="{{ form.name | default: customer.name }}" required>
          </label>
          <label class="field">
            <span>{{ 'contact.email' | t }}</span>
            <input class="input" type="email" name="contact[email]" value="{{ form.email | default: customer.email }}" required>
          </label>
        </div>
        <label class="field">
          <span>{{ 'contact.phone' | t }}</span>
          <input class="input" type="tel" name="contact[phone]" value="{{ form.phone }}" inputmode="tel">
        </label>
        <label class="field">
          <span>{{ 'contact.message' | t }}</span>
          <textarea class="input" rows="5" name="contact[body]" required>{{ form.body }}</textarea>
        </label>
        <button class="btn btn--lg" type="submit">{{ 'contact.send' | t }}</button>
      {%- endform -%}
    </div>
    <aside class="contact-sec__side">
      {%- assign wa_number = settings.social_whatsapp | remove: '+' | remove: ' ' -%}
      {%- if wa_number != blank -%}
        <div class="contact-card">
          <svg class="icon"><use href="#i-whatsapp"/></svg>
          <strong>{{ section.settings.wa_title }}</strong>
          <p>{{ section.settings.hours }}</p>
          <a class="btn btn--ghost btn--sm" href="https://wa.me/{{ wa_number }}" target="_blank" rel="noopener">{{ 'general.whatsapp_chat' | t }}</a>
        </div>
      {%- endif -%}
      {%- if section.settings.phone != blank -%}
        <div class="contact-card">
          <svg class="icon"><use href="#i-phone"/></svg>
          <strong>{{ 'contact.phone' | t }}</strong>
          <p><a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a></p>
        </div>
      {%- endif -%}
      <div class="contact-card">
        <svg class="icon"><use href="#i-mail"/></svg>
        <strong>{{ 'contact.email' | t }}</strong>
        <p><a href="mailto:{{ shop.email }}">{{ shop.email }}</a></p>
      </div>
      {%- if section.settings.note != blank -%}
        <div class="contact-card">
          <svg class="icon"><use href="#i-return"/></svg>
          <strong>{{ section.settings.note_title }}</strong>
          <p>{{ section.settings.note }}</p>
        </div>
      {%- endif -%}
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Contact page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Customer care"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (if page has no title)",
      "default": "Get in touch"
    },
    {
      "type": "text",
      "id": "wa_title",
      "label": "WhatsApp card title",
      "default": "Chat on WhatsApp"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Support hours",
      "default": "Mon–Sat, 10 am – 7 pm IST"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+91 98765 43210"
    },
    {
      "type": "text",
      "id": "note_title",
      "label": "Extra card title",
      "default": "Returns & re-plating"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Extra card text",
      "default": "15-day easy returns · lifetime plating warranty on every piece."
    }
  ]
}
{% endschema %}
