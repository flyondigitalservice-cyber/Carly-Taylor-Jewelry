{%- comment -%} Collection page: banner, filters (native Shopify), sort, product grid, pagination {%- endcomment -%}
{%- assign per_page = section.settings.products_per_page | default: 12 -%}
{%- assign has_banner = false -%}
{%- if section.settings.show_banner and collection.description != blank -%}{%- assign has_banner = true -%}{%- endif -%}
{%- if section.settings.show_banner and section.settings.show_image and collection.image -%}{%- assign has_banner = true -%}{%- endif -%}

{%- if has_banner -%}
<section class="colbanner{% if section.settings.show_image and collection.image %} colbanner--image{% endif %}" style="{% if section.settings.banner_bg != blank %}background:{{ section.settings.banner_bg }}{% endif %}">
  <div class="container colbanner__inner">
    {%- if collection.image and section.settings.show_image -%}
      <div class="colbanner__img">{{ collection.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 1024px) 50vw, 100vw', alt: collection.title, loading: 'eager', fetchpriority: 'high' }}</div>
    {%- endif -%}
    <div class="colbanner__copy">
      {%- render 'breadcrumbs', collection: collection -%}
      <h1 class="h1">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<div class="rte colbanner__desc">{{ collection.description }}</div>{%- endif -%}
    </div>
  </div>
</section>
{%- else -%}
<div class="container pagehead">
  {%- render 'breadcrumbs', collection: collection -%}
  <h1 class="h1">{{ collection.title }}</h1>
</div>
{%- endif -%}

<section class="collayout container section-gap-narrow" id="CollectionBody" data-section-id="{{ section.id }}" data-results>
  {%- paginate collection.products by per_page -%}
    <div class="collayout__inner{% unless section.settings.show_filters %} collayout__inner--nofilters{% endunless %}">
      {%- if section.settings.show_filters -%}
        <aside class="collayout__side">
          {%- render 'facets', results: collection, id: section.id -%}
        </aside>
      {%- endif -%}
      <div class="collayout__main" data-results-main>
        {%- if collection.products.size == 0 -%}
          <div class="empty">
            <svg class="icon empty__icon"><use href="#i-search"/></svg>
            <p>{{ 'collection.no_results' | t }}</p>
            {%- if collection.filters.size > 0 -%}
              <a class="btn btn--ghost" href="{{ collection.url }}" data-facet-link>{{ 'collection.reset' | t }}</a>
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="pgrid pgrid--{{ section.settings.columns | default: 3 }}" data-product-grid>
            {%- for product in collection.products -%}
              {%- render 'product-card', product: product, index: forloop.index0 -%}
            {%- endfor -%}
          </div>
          {%- render 'pagination', paginate: paginate, anchor: '#CollectionBody' -%}
        {%- endif -%}
      </div>
    </div>
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collection page",
  "settings": [
    { "type": "checkbox", "id": "show_banner", "label": "Show collection banner", "default": true },
    { "type": "checkbox", "id": "show_image", "label": "Show collection image", "default": true },
    { "type": "color", "id": "banner_bg", "label": "Banner background" },
    { "type": "checkbox", "id": "show_filters", "label": "Show filters & sorting", "default": true, "info": "Choose which filters appear (Coating, Size, Price, Availability…) in the free Shopify Search & Discovery app." },
    { "type": "range", "id": "products_per_page", "min": 6, "max": 48, "step": 3, "label": "Products per page", "default": 24 },
    { "type": "select", "id": "columns", "label": "Columns (desktop)", "options": [
      { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }
    ], "default": "4" }
  ]
}
{% endschema %}
