{% doc %}
  Full-bleed photographic banner used twice on the Carly Taylor homepage:
  once as the hero (fullscreen, gradient from the left, pill button) and
  once as the mid-page promo banner (fixed height, gradient from the
  right, square button) -- one section covers both via settings rather
  than duplicating near-identical markup.
{% enddoc %}

{{ 'ct-homepage-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ct_height_class = 'ct-hero--fullscreen'
  if section.settings.min_height == 'large'
    assign ct_height_class = 'ct-hero--large'
  endif

  assign ct_gradient_class = 'ct-hero--gradient-left'
  if section.settings.gradient_direction == 'right'
    assign ct_gradient_class = 'ct-hero--gradient-right'
  endif

  assign ct_button_class = 'ct-btn--dark'
  case section.settings.button_style
    when 'light'
      assign ct_button_class = 'ct-btn--light'
    when 'square'
      assign ct_button_class = 'ct-btn--dark ct-btn--square'
  endcase

  assign ct_loading = 'lazy'
  assign ct_fetchpriority = 'auto'
  if section.settings.eager_load
    assign ct_loading = 'eager'
    assign ct_fetchpriority = 'high'
  endif

  assign ct_heading_tag = section.settings.heading_tag | default: 'h2'

  assign ct_default_image = 'ct-hero-default.jpg'
  if section.settings.min_height == 'large'
    assign ct_default_image = 'ct-banner-default.jpg'
  endif

  assign ct_image_alt = section.settings.image.alt | default: ''
-%}

<section class="ct-hero {{ ct_height_class }} {{ ct_gradient_class }} ct-hero--content-{{ section.settings.content_position }}">
  <div class="ct-hero__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 3200
        | image_tag:
          loading: ct_loading,
          fetchpriority: ct_fetchpriority,
          widths: '750, 1100, 1500, 2000, 2600, 3200',
          sizes: '100vw',
          class: 'ct-hero__media-img',
          alt: ct_image_alt
      }}
    {%- else -%}
      <img
        src="{{ ct_default_image | asset_url }}"
        alt=""
        loading="{{ ct_loading }}"
        {% if ct_fetchpriority == 'high' %}
          fetchpriority="high"
        {% endif %}
        class="ct-hero__media-img"
      >
    {%- endif -%}
  </div>
  <div class="ct-hero__overlay" aria-hidden="true"></div>
  <div class="ct-hero__content-wrap page-width">
    <div class="ct-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ct-eyebrow ct-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <{{ ct_heading_tag }} class="ct-hero__heading">{{ section.settings.heading }}</{{ ct_heading_tag }}>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="ct-hero__body rte">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
          class="ct-btn {{ ct_button_class }} ct-hero__button"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.ct_hero.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.ct_hero.settings.image.label"
    },
    {
      "type": "select",
      "id": "min_height",
      "label": "t:sections.ct_hero.settings.min_height.label",
      "options": [
        { "value": "fullscreen", "label": "t:sections.ct_hero.settings.min_height.options__1.label" },
        { "value": "large", "label": "t:sections.ct_hero.settings.min_height.options__2.label" }
      ],
      "default": "fullscreen"
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "t:sections.ct_hero.settings.gradient_direction.label",
      "options": [
        { "value": "left", "label": "t:sections.ct_hero.settings.gradient_direction.options__1.label" },
        { "value": "right", "label": "t:sections.ct_hero.settings.gradient_direction.options__2.label" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:sections.ct_hero.settings.content_position.label",
      "options": [
        { "value": "middle-left", "label": "t:sections.ct_hero.settings.content_position.options__1.label" },
        { "value": "middle-center", "label": "t:sections.ct_hero.settings.content_position.options__2.label" },
        { "value": "middle-right", "label": "t:sections.ct_hero.settings.content_position.options__3.label" },
        { "value": "bottom-left", "label": "t:sections.ct_hero.settings.content_position.options__4.label" },
        { "value": "bottom-right", "label": "t:sections.ct_hero.settings.content_position.options__5.label" }
      ],
      "default": "middle-left"
    },
    {
      "type": "header",
      "content": "t:sections.ct_hero.settings.header_content.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.ct_hero.settings.eyebrow.label",
      "default": "Carly Taylor Jewelry"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.ct_hero.settings.heading_tag.label",
      "info": "t:sections.ct_hero.settings.heading_tag.info",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h2"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.ct_hero.settings.heading.label",
      "info": "t:sections.ct_hero.settings.heading.info",
      "default": "Pieces you'll reach <em>for every day</em>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:sections.ct_hero.settings.body.label",
      "default": "<p>Gold and silver jewelry made to be lived in.</p>"
    },
    {
      "type": "header",
      "content": "t:sections.ct_hero.settings.header_button.content"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.ct_hero.settings.button_label.label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.ct_hero.settings.button_link.label"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:sections.ct_hero.settings.button_style.label",
      "options": [
        { "value": "dark", "label": "t:sections.ct_hero.settings.button_style.options__1.label" },
        { "value": "light", "label": "t:sections.ct_hero.settings.button_style.options__2.label" },
        { "value": "square", "label": "t:sections.ct_hero.settings.button_style.options__3.label" }
      ],
      "default": "dark"
    },
    {
      "type": "header",
      "content": "t:sections.ct_hero.settings.header_advanced.content"
    },
    {
      "type": "checkbox",
      "id": "eager_load",
      "label": "t:sections.ct_hero.settings.eager_load.label",
      "info": "t:sections.ct_hero.settings.eager_load.info",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:sections.ct_hero.presets.name"
    }
  ]
}
{% endschema %}
