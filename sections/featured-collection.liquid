{%- comment -%} Product carousel / grid from a collection {%- endcomment -%}
{%- assign col = section.settings.collection | default: collections['best-seller'] | default: collections['all'] -%}
{%- assign limit = section.settings.limit | default: 8 -%}
<section class="featcol section-gap" id="Section-{{ section.id }}">
  <div class="container">
    <div class="sechead sechead--split sechead--{{ section.settings.align }}">
      <div>
        {%- if section.settings.subheading != blank -%}<span class="eyebrow">{{ section.settings.subheading }}</span>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading | default: col.title }}</h2>
        {%- if section.settings.text != blank -%}<p class="sechead__text">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.layout == 'carousel' -%}
        <div class="sechead__nav">
          <button class="iconbtn" data-carousel-prev aria-label="{{ 'general.previous' | t }}"><svg class="icon"><use href="#i-chev-l"/></svg></button>
          <button class="iconbtn" data-carousel-next aria-label="{{ 'general.next' | t }}"><svg class="icon"><use href="#i-chev-r"/></svg></button>
        </div>
      {%- else -%}
        <a class="sechead__all link-underline" href="{{ col.url }}">{{ 'general.view_all' | t }} <svg class="icon"><use href="#i-arrow-r"/></svg></a>
      {%- endif -%}
    </div>

    {%- if section.settings.layout == 'carousel' -%}
      <div class="carousel" data-carousel>
        <div class="carousel__track" data-carousel-track>
          {%- for product in col.products limit: limit -%}
            <div class="carousel__slide">
              {%- render 'product-card', product: product, index: forloop.index0 -%}
            </div>
          {%- else -%}
            {%- for i in (1..limit) -%}<div class="carousel__slide">{%- render 'placeholder-card', index: forloop.index0 -%}</div>{%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <div class="pgrid pgrid--{{ section.settings.columns }}">
        {%- for product in col.products limit: limit -%}
          {%- render 'product-card', product: product, index: forloop.index0 -%}
        {%- else -%}
          {%- for i in (1..limit) -%}{%- render 'placeholder-card', index: forloop.index0 -%}{%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "subheading", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "text", "label": "Subtext" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [
      { "value": "carousel", "label": "Carousel" }, { "value": "grid", "label": "Grid" }
    ], "default": "carousel" },
    { "type": "select", "id": "columns", "label": "Grid columns (desktop)", "options": [
      { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }
    ], "default": "4" },
    { "type": "range", "id": "limit", "min": 2, "max": 16, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "select", "id": "align", "label": "Heading align", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }
    ], "default": "left" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
