{% doc %}
  "Shop by category" homepage grid -- four uniform tiles (collection image
  + a pill label overlaid bottom-left), unlike Dawn's card-collection
  snippet which places the title below the image. Built as its own
  section rather than configuring sections/collection-list.liquid because
  that overlay treatment and the fixed 4/5 aspect ratio aren't reachable
  through its settings.
{% enddoc %}

{{ 'ct-homepage-sections.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="ct-category-grid__heading-row">
      {%- if section.settings.heading != blank -%}
        <h2 class="ct-category-grid__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.view_all_label != blank -%}
        <a
          {% if section.settings.view_all_link != blank %}
            href="{{ section.settings.view_all_link }}"
          {% else %}
            href="{{ routes.all_products_collection_url }}"
          {% endif %}
          class="ct-category-grid__view-all"
        >
          {{- section.settings.view_all_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    <div class="ct-category-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign ct_default_index = forloop.index0 | modulo: 4 | plus: 1
          assign ct_default_image = 'ct-cat-necklaces-default.jpg'
          case ct_default_index
            when 2
              assign ct_default_image = 'ct-cat-bracelets-default.jpg'
            when 3
              assign ct_default_image = 'ct-cat-earrings-default.jpg'
            when 4
              assign ct_default_image = 'ct-cat-anklets-default.jpg'
          endcase

          assign ct_label = block.settings.label
          if ct_label == blank and block.settings.collection != blank
            assign ct_label = block.settings.collection.title
          endif
          assign ct_label_escaped = ct_label | escape

          comment
            Link target, in order of preference:
              1. the collection picked on the block in the theme editor
              2. a collection whose handle matches the label ("Necklaces" ->
                 /collections/necklaces), so the tiles point at the right place
                 before anyone opens the editor
              3. the same path built by hand, for when the collection has not
                 been created yet -- still the correct final URL
              4. all products
          endcomment
          assign ct_url = block.settings.collection.url

          if ct_url == blank and ct_label != blank
            assign ct_handle = ct_label | handleize
            assign ct_matched = collections[ct_handle]
            if ct_matched != empty and ct_matched.handle != blank
              assign ct_url = ct_matched.url
            else
              assign ct_url = '/collections/' | append: ct_handle
            endif
          endif

          assign ct_url = ct_url | default: routes.all_products_collection_url
        -%}
        <a
          href="{{ ct_url }}"
          class="ct-category-grid__tile"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1500
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1100, 1500',
                sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw',
                class: 'ct-category-grid__image',
                alt: ct_label_escaped
            }}
          {%- elsif block.settings.collection.featured_image != blank -%}
            {{
              block.settings.collection.featured_image
              | image_url: width: 1500
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1100, 1500',
                sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw',
                class: 'ct-category-grid__image',
                alt: ct_label_escaped
            }}
          {%- else -%}
            <img
              src="{{ ct_default_image | asset_url }}"
              alt="{{ ct_label | escape }}"
              loading="lazy"
              class="ct-category-grid__image"
            >
          {%- endif -%}
          {%- if ct_label != blank -%}
            <span class="ct-category-grid__label">{{ ct_label }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.ct_category_grid.name",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.ct_category_grid.settings.heading.label",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:sections.ct_category_grid.settings.view_all_label.label",
      "default": "View all pieces"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "t:sections.ct_category_grid.settings.view_all_link.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-6"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 44
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:sections.ct_category_grid.blocks.category.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.ct_category_grid.blocks.category.settings.collection.label"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.ct_category_grid.blocks.category.settings.label.label",
          "info": "t:sections.ct_category_grid.blocks.category.settings.label.info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.ct_category_grid.blocks.category.settings.image.label",
          "info": "t:sections.ct_category_grid.blocks.category.settings.image.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.ct_category_grid.presets.name",
      "blocks": [
        { "type": "category", "settings": { "label": "Necklaces" } },
        { "type": "category", "settings": { "label": "Bracelets" } },
        { "type": "category", "settings": { "label": "Earrings" } },
        { "type": "category", "settings": { "label": "Anklets" } }
      ]
    }
  ]
}
{% endschema %}
