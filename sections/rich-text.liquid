<section class="richtext section-gap" id="Section-{{ section.id }}">
  <div class="container richtext__inner richtext__inner--{{ section.settings.align }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}<span class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        {%- when 'heading' -%}<h2 class="{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
        {%- when 'text' -%}<div class="rte richtext__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          {%- if block.settings.link != blank -%}<a class="btn{% if block.settings.ghost %} btn--ghost{% endif %}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>{%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "select", "id": "align", "label": "Alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }
    ], "default": "center" }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Eyebrow", "limit": 1, "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Our promise" } ] },
    { "type": "heading", "name": "Heading", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Jewellery made to be worn, every single day" },
      { "type": "select", "id": "size", "label": "Size", "options": [ { "value": "h1", "label": "Large" }, { "value": "h2", "label": "Medium" }, { "value": "h3", "label": "Small" } ], "default": "h2" }
    ] },
    { "type": "text", "name": "Text", "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share the story of your brand, a festive message or details about a collection.</p>" } ] },
    { "type": "button", "name": "Button", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Shop now" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "checkbox", "id": "ghost", "label": "Outline style", "default": false }
    ] }
  ],
  "presets": [{ "name": "Rich text", "blocks": [{ "type": "eyebrow" }, { "type": "heading" }, { "type": "text" }, { "type": "button" }] }]
}
{% endschema %}
