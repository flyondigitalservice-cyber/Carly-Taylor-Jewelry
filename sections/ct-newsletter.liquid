{% doc %}
  Two-column newsletter panel -- image on one side, native customer
  email-signup form on the other, no gap, rounded outer panel. Built as
  its own section because Dawn's sections/newsletter.liquid has no image
  slot, and sections/image-with-text.liquid has no email-form block type;
  this combines that layout skeleton with newsletter.liquid's
  {% form 'customer' %} logic so a real, marketing-subscribed customer is
  created on submit rather than this being a cosmetic-only form.
{% enddoc %}

{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'ct-homepage-sections.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}
  The colour scheme belongs on the OUTER wrapper, matching every other section
  on the page (ct-category-grid, featured-collection, multicolumn all render
  `color-scheme-N gradient` there). It used to sit on the inner .ct-newsletter
  panel instead, where the panel's own linen background covered it -- leaving
  the section itself unpainted, so this strip alone showed the raw body
  background while the sections above and below were cream.
{%- endcomment -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="ct-newsletter ct-newsletter--image-{{ section.settings.image_side }}">
    <div class="ct-newsletter__media">
      {%- assign ct_image_alt = section.settings.image.alt | default: '' -%}
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 900, 1200, 1600',
            sizes: '(min-width: 750px) 50vw, 100vw',
            class: 'ct-newsletter__media-img',
            alt: ct_image_alt
        }}
      {%- else -%}
        <img
          src="{{ 'ct-newsletter-default.jpg' | asset_url }}"
          alt=""
          loading="lazy"
          class="ct-newsletter__media-img"
        >
      {%- endif -%}
    </div>
    <div class="ct-newsletter__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ct-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ct-newsletter__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="ct-newsletter__body rte">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- form 'customer', id: 'CtNewsletterForm', class: 'ct-newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="ct-newsletter__field-row">
          <label class="visually-hidden" for="CtNewsletterEmail-{{ section.id }}">
            {{ 'newsletter.label' | t }}
          </label>
          <input
            id="CtNewsletterEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            class="ct-newsletter__input"
            value="{{ form.email }}"
            placeholder="{{ 'sections.ct_newsletter.email_placeholder' | t }}"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            required
            aria-required="true"
            {% if form.errors %}
              autofocus
              aria-invalid="true"
              aria-describedby="CtNewsletterError-{{ section.id }}"
            {% elsif form.posted_successfully? %}
              aria-describedby="CtNewsletterSuccess-{{ section.id }}"
            {% endif %}
          >
          <button type="submit" class="ct-btn ct-btn--dark ct-newsletter__submit">
            {{- section.settings.button_label | escape -}}
          </button>
        </div>
        {%- if form.errors -%}
          <p id="CtNewsletterError-{{ section.id }}" class="ct-newsletter__message ct-newsletter__message--error" role="alert">
            {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
          </p>
        {%- endif -%}
        {%- if form.posted_successfully? -%}
          <p
            id="CtNewsletterSuccess-{{ section.id }}"
            class="ct-newsletter__message ct-newsletter__message--success"
            role="status"
            tabindex="-1"
            autofocus
          >
            {{- 'sections.ct_newsletter.success' | t -}}
          </p>
        {%- endif -%}
      {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.ct_newsletter.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.ct_newsletter.settings.image.label"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "t:sections.ct_newsletter.settings.image_side.label",
      "options": [
        { "value": "left", "label": "t:sections.ct_newsletter.settings.image_side.options__1.label" },
        { "value": "right", "label": "t:sections.ct_newsletter.settings.image_side.options__2.label" }
      ],
      "default": "right"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.ct_newsletter.settings.eyebrow.label",
      "default": "Stay in touch"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.ct_newsletter.settings.heading.label",
      "default": "Be first to meet <em>the new pieces</em>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:sections.ct_newsletter.settings.body.label",
      "default": "<p>New arrivals, restocks, and subscriber-only offers.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.ct_newsletter.settings.button_label.label",
      "default": "Subscribe"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-6"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "t:sections.ct_newsletter.presets.name"
    }
  ]
}
{% endschema %}
