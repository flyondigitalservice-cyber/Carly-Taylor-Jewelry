{%- comment -%} Quick-add / quick-view modal shell. Filled by product.js from /products/{handle}?view=quick {%- endcomment -%}
<div class="modal" id="QuickView" data-modal="quickview" role="dialog" aria-modal="true" aria-label="{{ 'products.quick_view' | t }}" hidden>
  <div class="modal__scrim" data-modal-close></div>
  <div class="modal__panel">
    <button class="iconbtn modal__close" data-modal-close aria-label="{{ 'general.close' | t }}"><svg class="icon"><use href="#i-close"/></svg></button>
    <div class="modal__body" data-quickview-body>
      <div class="modal__loader"><span class="spinner"></span></div>
    </div>
  </div>
</div>
