{%- comment -%}
  Star rating from Shopify's standard review metafields (reviews.rating / reviews.rating_count),
  which Judge.me, Loox, Yotpo, Okendo and most review apps write to. Args: product, show_count, size
{%- endcomment -%}
{%- liquid
  assign r_mf = product.metafields.reviews.rating.value
  if r_mf != blank
    assign rating = r_mf.rating | plus: 0
    assign scale = r_mf.scale_max | default: 5 | plus: 0
    assign count = product.metafields.reviews.rating_count.value | default: 0
  endif
-%}
{%- if r_mf != blank and settings.reviews_enable and count > 0 -%}
  {%- assign pct = rating | divided_by: scale | times: 100 -%}
  <div class="rating rating--{{ size | default: 'sm' }}" role="img" aria-label="{{ 'accessibility.star_reviews' | t: count: rating }}">
    <span class="rating__stars" style="--fill: {{ pct }}%">
      <span class="rating__row rating__row--bg" aria-hidden="true">
        <svg class="icon"><use href="#i-star-o"/></svg><svg class="icon"><use href="#i-star-o"/></svg><svg class="icon"><use href="#i-star-o"/></svg><svg class="icon"><use href="#i-star-o"/></svg><svg class="icon"><use href="#i-star-o"/></svg>
      </span>
      <span class="rating__row rating__row--fg" aria-hidden="true">
        <svg class="icon"><use href="#i-star"/></svg><svg class="icon"><use href="#i-star"/></svg><svg class="icon"><use href="#i-star"/></svg><svg class="icon"><use href="#i-star"/></svg><svg class="icon"><use href="#i-star"/></svg>
      </span>
    </span>
    {%- if show_count != false -%}<span class="rating__count">({{ count }})</span>{%- endif -%}
  </div>
{%- endif -%}
