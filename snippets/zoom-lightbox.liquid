<div class="lightbox" id="ZoomLightbox" data-lightbox role="dialog" aria-modal="true" aria-label="Product image zoom" hidden>
  <button class="iconbtn lightbox__close" data-lightbox-close aria-label="{{ 'general.close' | t }}"><svg class="icon"><use href="#i-close"/></svg></button>
  <button class="iconbtn lightbox__nav lightbox__nav--prev" data-lightbox-prev aria-label="{{ 'general.previous' | t }}"><svg class="icon"><use href="#i-chev-l"/></svg></button>
  <figure class="lightbox__stage" data-lightbox-stage></figure>
  <button class="iconbtn lightbox__nav lightbox__nav--next" data-lightbox-next aria-label="{{ 'general.next' | t }}"><svg class="icon"><use href="#i-chev-r"/></svg></button>
</div>
