{%- comment -%}
  Filter + sort UI for collection & search, built on Shopify's native storefront filtering
  (manage the filters in the free "Shopify Search & Discovery" app: Coating, Size, Price,
  Availability, Product type, metafields…). Works server-side; collection.js adds AJAX.
  Args: results (collection or search), id (section id)
{%- endcomment -%}
{%- liquid
  assign sort_by = results.sort_by | default: results.default_sort_by
  if request.page_type == 'search'
    assign q_enc = search.terms | url_encode
    assign clear_url = routes.search_url | append: '?type=product&q=' | append: q_enc
  else
    assign clear_url = results.url | append: '?sort_by=' | append: sort_by
  endif
  assign swatch_names = settings.swatch_option_names | downcase | split: ','
  assign swatch_hs = ''
  for n in swatch_names
    assign nh = n | handleize
    assign swatch_hs = swatch_hs | append: '|' | append: nh
  endfor
  assign swatch_hs = swatch_hs | split: '|'
  assign active_count = 0
  for filter in results.filters
    assign active_count = active_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_count = active_count | plus: 1
      endif
    endif
  endfor
-%}
<div class="facets" data-facets id="Filters-{{ id }}">
  <form class="facets__form" action="{% if request.page_type == 'search' %}{{ routes.search_url }}{% else %}{{ results.url }}{% endif %}" method="get" data-facet-form>
    {%- if request.page_type == 'search' -%}
      <input type="hidden" name="q" value="{{ search.terms | escape }}">
      <input type="hidden" name="type" value="product">
    {%- endif -%}
    <input type="hidden" name="sort_by" value="{{ sort_by }}" data-sort-hidden>

    <div class="facets__head">
      <h2 class="facets__title"><svg class="icon"><use href="#i-filter"/></svg>{{ 'collection.filters' | t }}</h2>
      {%- if active_count > 0 -%}
        <a class="facets__clear link-underline" href="{{ clear_url }}" data-facet-link>{{ 'collection.clear_all' | t }}</a>
      {%- endif -%}
      <button type="button" class="iconbtn facets__close" data-close-filters aria-label="{{ 'general.close' | t }}"><svg class="icon"><use href="#i-close"/></svg></button>
    </div>

    <div class="facets__scroll">
      {%- if results.filters.size == 0 -%}
        <p class="facets__empty">{{ 'collection.no_filters' | t }}</p>
      {%- endif -%}
      {%- for filter in results.filters -%}
        {%- assign filter_h = filter.label | handleize -%}
        {%- assign is_swatch = false -%}
        {%- if filter.presentation == 'swatch' or swatch_hs contains filter_h -%}{%- assign is_swatch = true -%}{%- endif -%}
        {%- assign is_open = true -%}
        {%- if forloop.index > 3 and filter.active_values.size == 0 -%}{%- assign is_open = false -%}{%- endif -%}

        <div class="facet{% unless is_open %} is-closed{% endunless %}" data-facet data-facet-key="{{ filter.param_name | escape }}">
          <button type="button" class="facet__head" aria-expanded="{{ is_open }}">
            <span>{{ filter.label }}{% if filter.active_values.size > 0 %} <em class="facet__count">{{ filter.active_values.size }}</em>{% endif %}</span>
            <svg class="icon"><use href="#i-chev-d"/></svg>
          </button>
          <div class="facet__body">
            {%- case filter.type -%}
              {%- when 'list', 'boolean' -%}
                <div class="{% if is_swatch %}facet__swatches{% elsif filter_h contains 'size' or filter_h contains 'length' %}facet__sizes{% else %}facet__list{% endif %}">
                  {%- for value in filter.values -%}
                    {%- assign disabled = false -%}
                    {%- if value.count == 0 and value.active == false -%}{%- assign disabled = true -%}{%- endif -%}
                    {%- if is_swatch -%}
                      {%- liquid
                        assign sw_style = 'var(--sw-' | append: value.label | handleize | append: ', #ccc)'
                        if value.swatch.image
                          assign sw_style = value.swatch.image | image_url: width: 60 | prepend: 'url(' | append: ') center/cover'
                        elsif value.swatch.color
                          assign sw_style = value.swatch.color
                        endif
                      -%}
                      <label class="check check--swatch{% if disabled %} is-disabled{% endif %}">
                        <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if disabled %}disabled{% endif %} data-facet-input>
                        <span class="swatch__dot" style="--sw: {{ sw_style }}"></span>
                        <span>{{ value.label }} <em>({{ value.count }})</em></span>
                      </label>
                    {%- elsif filter_h contains 'size' or filter_h contains 'length' -%}
                      <label class="check check--size{% if disabled %} is-disabled{% endif %}">
                        <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if disabled %}disabled{% endif %} data-facet-input>
                        <span>{{ value.label }}</span>
                      </label>
                    {%- else -%}
                      <label class="check{% if disabled %} is-disabled{% endif %}">
                        <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if disabled %}disabled{% endif %} data-facet-input>
                        <span class="check__box"><svg class="icon"><use href="#i-check"/></svg></span>
                        <span>{{ value.label }} <em>({{ value.count }})</em></span>
                      </label>
                    {%- endif -%}
                  {%- endfor -%}
                </div>

              {%- when 'price_range' -%}
                {%- liquid
                  assign range_max = filter.range_max | divided_by: 100 | ceil
                  if range_max < 1
                    assign range_max = 1
                  endif
                  assign cur_min = 0
                  assign cur_max = range_max
                  if filter.min_value.value != nil
                    assign cur_min = filter.min_value.value | divided_by: 100
                  endif
                  if filter.max_value.value != nil
                    assign cur_max = filter.max_value.value | divided_by: 100
                  endif
                  assign step = 50
                  if range_max > 20000
                    assign step = 500
                  elsif range_max > 5000
                    assign step = 100
                  endif
                -%}
                <div class="pricerange" data-price-range data-max="{{ range_max }}" data-step="{{ step }}">
                  <div class="pricerange__track"><div class="pricerange__fill" data-price-fill></div></div>
                  <input type="range" min="0" max="{{ range_max }}" step="{{ step }}" value="{{ cur_min }}" data-price-min aria-label="{{ 'collection.min_price' | t }}">
                  <input type="range" min="0" max="{{ range_max }}" step="{{ step }}" value="{{ cur_max }}" data-price-max aria-label="{{ 'collection.max_price' | t }}">
                  <div class="pricerange__inputs">
                    <label class="pricerange__field"><span>₹</span>
                      <input class="input" type="number" inputmode="numeric" min="0" max="{{ range_max }}" name="{{ filter.min_value.param_name }}"
                             value="{% if filter.min_value.value != nil %}{{ cur_min }}{% endif %}" placeholder="0" aria-label="{{ 'collection.min_price' | t }}" data-price-input-min>
                    </label>
                    <span class="pricerange__dash">–</span>
                    <label class="pricerange__field"><span>₹</span>
                      <input class="input" type="number" inputmode="numeric" min="0" max="{{ range_max }}" name="{{ filter.max_value.param_name }}"
                             value="{% if filter.max_value.value != nil %}{{ cur_max }}{% endif %}" placeholder="{{ range_max }}" aria-label="{{ 'collection.max_price' | t }}" data-price-input-max>
                    </label>
                  </div>
                </div>
            {%- endcase -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="facets__foot">
      <button type="submit" class="btn btn--block" data-apply-filters>{{ 'collection.apply' | t }}</button>
    </div>
  </form>

  <div class="toolbar">
    <button type="button" class="btn btn--ghost toolbar__filter" data-open-filters>
      <svg class="icon"><use href="#i-filter"/></svg>{{ 'collection.filter' | t }}
      {%- if active_count > 0 -%}<span class="toolbar__count">{{ active_count }}</span>{%- endif -%}
    </button>
    <p class="toolbar__results" data-results-count>{{ 'collection.product_count' | t: count: results.products_count | default: results.results_count }}</p>
    <div class="toolbar__sort">
      <label class="toolbar__sortlabel" for="SortBy-{{ id }}">{{ 'collection.sort_by' | t }}</label>
      <div class="opt__select opt__select--sm">
        <select id="SortBy-{{ id }}" class="select" data-sort-select>
          {%- for option in results.sort_options -%}
            <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
        <svg class="icon select__chev"><use href="#i-chev-d"/></svg>
      </div>
    </div>
  </div>

  {%- if active_count > 0 -%}
    <div class="facets__pills">
      {%- for filter in results.filters -%}
        {%- for value in filter.active_values -%}
          <a class="chip is-active" href="{{ value.url_to_remove }}" data-facet-link>{{ filter.label }}: {{ value.label }} <svg class="icon"><use href="#i-close"/></svg></a>
        {%- endfor -%}
        {%- if filter.type == 'price_range' -%}
          {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
            <a class="chip is-active" href="{{ filter.url_to_remove }}" data-facet-link>
              {%- render 'money', amount: filter.min_value.value %} – {% if filter.max_value.value != nil %}{%- render 'money', amount: filter.max_value.value -%}{% else %}{%- render 'money', amount: filter.range_max -%}{% endif %}
              <svg class="icon"><use href="#i-close"/></svg>
            </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      <a class="chip" href="{{ clear_url }}" data-facet-link>{{ 'collection.clear_all' | t }}</a>
    </div>
  {%- endif -%}
</div>
